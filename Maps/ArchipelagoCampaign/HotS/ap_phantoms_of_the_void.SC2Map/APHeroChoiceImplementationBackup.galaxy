// Temporary backup for the Phantoms of the Void AP hero-choice implementation.
// This file is not generated by the SC2 Trigger Editor. It exists so the
// MapScript.galaxy-only patch can be restored or ported into real trigger data.
//
// Intended behavior:
// - Intro Complete calls gf_AP_HeroChoiceOffer().
// - If more than one hero is present, a dialog asks which hero to remove and
//   Mid Q waits until the player clicks.
// - The selected hero bit is subtracted from AP_Triggers_Option_HeroPresence.
// - Existing heroes are hidden after selection.
// - Mid Cleanup calls AP_Triggers_HeroInit again at Player Rally Point:
//   PointFromId(176).
// - If zero/one hero is present, no dialog is shown; the one-hero case removes
//   that bit, hides existing heroes, and continues immediately.

// Globals:
int gv_apHeroChoiceScreen;
int[4] gv_apHeroChoicePanel;
int[4] gv_apHeroChoiceButton;
int[4] gv_apHeroChoiceBit;
int gv_apHeroChoiceCount;
int gv_apRemovedHeroBit;

// InitGlobals additions:
// gv_apHeroChoiceScreen = c_invalidDialogId;
// for (init_i = 0; init_i <= 3; init_i += 1) {
//     gv_apHeroChoicePanel[init_i] = c_invalidDialogId;
//     gv_apHeroChoiceButton[init_i] = c_invalidDialogControlId;
//     gv_apHeroChoiceBit[init_i] = 0;
// }

int gf_AP_HeroChoiceGetPresence () {
    return libABFE498B_gv_aP_Triggers_Option_HeroPresence;
}

void gf_AP_HeroChoiceSetPresence (int lp_presence) {
    libABFE498B_gv_aP_Triggers_Option_HeroPresence = lp_presence;
}

bool gf_AP_HeroChoiceHasBit (int lp_presence, int lp_bit) {
    int lv_shifted;

    lv_shifted = (lp_presence / lp_bit);
    return ((lv_shifted - ((lv_shifted / 2) * 2)) == 1);
}

text gf_AP_HeroChoiceName (int lp_heroBit) {
    if ((lp_heroBit == 1)) {
        return StringToText("Kerrigan");
    }
    else if ((lp_heroBit == 2)) {
        return StringToText("Nova");
    }
    else if ((lp_heroBit == 4)) {
        return StringToText("Artanis");
    }
    return StringToText("Unknown Hero");
}

void gf_AP_HeroChoiceRemoveHero (int lp_heroBit) {
    int lv_presence;

    if ((lp_heroBit == 0)) {
        return ;
    }

    gv_apRemovedHeroBit = lp_heroBit;
    lv_presence = gf_AP_HeroChoiceGetPresence();
    if ((gf_AP_HeroChoiceHasBit(lv_presence, lp_heroBit) == false)) {
        return ;
    }

    gf_AP_HeroChoiceSetPresence((lv_presence - lp_heroBit));
}

void gf_AP_HeroChoiceHideExistingHeroes () {
    int lv_index;
    unit lv_hero;

    lv_index = 1;
    for ( ; lv_index <= 3; lv_index += 1 ) {
        lv_hero = libABFE498B_gv_aP_Triggers_HeroUnit[lv_index];
        if ((UnitIsValid(lv_hero) == true)) {
            libABFE498B_gf_AP_Triggers_HeroHide(lv_hero);
        }
    }
    if ((UnitIsValid(gv_kerrigan) == true)) {
        libABFE498B_gf_AP_Triggers_HeroHide(gv_kerrigan);
    }
}

void gf_AP_HeroChoiceClose () {
    int lv_i;

    if ((gv_apHeroChoiceScreen != c_invalidDialogId)) {
        DialogDestroy(gv_apHeroChoiceScreen);
    }
    gv_apHeroChoiceScreen = c_invalidDialogId;
    lv_i = 1;
    for ( ; lv_i <= 3; lv_i += 1 ) {
        if ((gv_apHeroChoicePanel[lv_i] != c_invalidDialogId)) {
            DialogDestroy(gv_apHeroChoicePanel[lv_i]);
        }
        gv_apHeroChoicePanel[lv_i] = c_invalidDialogId;
        gv_apHeroChoiceButton[lv_i] = c_invalidDialogControlId;
        gv_apHeroChoiceBit[lv_i] = 0;
    }
    gv_apHeroChoiceCount = 0;
    GameSetGlobalTimeScale(1.0);
    AITimePause(false);
}

void gf_AP_HeroChoiceCreatePanel (int lp_slot, int lp_heroBit, fixed lp_offset) {
    gv_apHeroChoiceBit[lp_slot] = lp_heroBit;
    DialogCreate(260, 170, c_anchorCenter, FixedToInt(lp_offset), 0, true);
    DialogSetRenderPriority(DialogLastCreated(), 105);
    DialogSetVisible(DialogLastCreated(), PlayerGroupAll(), true);
    gv_apHeroChoicePanel[lp_slot] = DialogLastCreated();
    libNtve_gf_CreateDialogItemImage(gv_apHeroChoicePanel[lp_slot], 260, 170, c_anchorCenter, 0, 0, StringToText(""), "Assets\\Textures\\hud_btn_bg_ability_blank.dds", c_triggerImageTypeNormal, true, Color(100,100,100), c_triggerBlendModeNormal);
    libNtve_gf_CreateDialogItemLabel(gv_apHeroChoicePanel[lp_slot], 220, 45, c_anchorTop, 0, 24, gf_AP_HeroChoiceName(lp_heroBit), ColorWithAlpha(0,0,0,0), true, 1.0);
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ABChoiceRewardsTitle", PlayerGroupAll());
    libNtve_gf_CreateDialogItemButton(gv_apHeroChoicePanel[lp_slot], 210, 55, c_anchorBottom, 0, 24, StringToText(""), (StringToText("Remove ") + gf_AP_HeroChoiceName(lp_heroBit)), "");
    gv_apHeroChoiceButton[lp_slot] = DialogControlLastCreated();
}

bool gf_AP_HeroChoiceOffer () {
    int lv_presence;
    int lv_slot;

    lv_presence = gf_AP_HeroChoiceGetPresence();

    if ((lv_presence == 0)) {
        return false;
    }

    gv_apHeroChoiceCount = 0;
    if ((gf_AP_HeroChoiceHasBit(lv_presence, 1) == true)) {
        gv_apHeroChoiceCount += 1;
        gv_apHeroChoiceBit[gv_apHeroChoiceCount] = 1;
    }
    if ((gf_AP_HeroChoiceHasBit(lv_presence, 2) == true)) {
        gv_apHeroChoiceCount += 1;
        gv_apHeroChoiceBit[gv_apHeroChoiceCount] = 2;
    }
    if ((gf_AP_HeroChoiceHasBit(lv_presence, 4) == true)) {
        gv_apHeroChoiceCount += 1;
        gv_apHeroChoiceBit[gv_apHeroChoiceCount] = 4;
    }

    if ((gv_apHeroChoiceCount == 0)) {
        return false;
    }
    if ((gv_apHeroChoiceCount == 1)) {
        gf_AP_HeroChoiceRemoveHero(gv_apHeroChoiceBit[1]);
        gf_AP_HeroChoiceHideExistingHeroes();
        return false;
    }

    DialogCreate(1800, 1100, c_anchorCenter, 0, 0, true);
    DialogSetRenderPriority(DialogLastCreated(), 100);
    DialogSetVisible(DialogLastCreated(), PlayerGroupAll(), true);
    DialogSetFullscreen(DialogLastCreated(), true);
    DialogSetTitle(DialogLastCreated(), StringToText("Choose a hero to remove from this mission"));
    gv_apHeroChoiceScreen = DialogLastCreated();
    GameSetGlobalTimeScale(0.02);
    AITimePause(true);

    lv_slot = 1;
    for ( ; lv_slot <= gv_apHeroChoiceCount; lv_slot += 1 ) {
        if ((gv_apHeroChoiceCount == 2)) {
            gf_AP_HeroChoiceCreatePanel(lv_slot, gv_apHeroChoiceBit[lv_slot], ((lv_slot * 340.0) - 510.0));
        }
        else {
            gf_AP_HeroChoiceCreatePanel(lv_slot, gv_apHeroChoiceBit[lv_slot], ((lv_slot * 260.0) - 520.0));
        }
    }
    return true;
}

bool gt_APHeroChoiceClicked_Func (bool testConds, bool runActions) {
    int autoClicked_val;

    if (testConds) {
        if (!((EventDialogControlEventType() == c_triggerControlEventTypeClick))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    autoClicked_val = EventDialogControl();
    if ((autoClicked_val == gv_apHeroChoiceButton[1])) {
        gf_AP_HeroChoiceRemoveHero(gv_apHeroChoiceBit[1]);
        gf_AP_HeroChoiceHideExistingHeroes();
        gf_AP_HeroChoiceClose();
        TriggerExecute(gt_MidQ, true, false);
    }
    else if ((autoClicked_val == gv_apHeroChoiceButton[2])) {
        gf_AP_HeroChoiceRemoveHero(gv_apHeroChoiceBit[2]);
        gf_AP_HeroChoiceHideExistingHeroes();
        gf_AP_HeroChoiceClose();
        TriggerExecute(gt_MidQ, true, false);
    }
    else if ((autoClicked_val == gv_apHeroChoiceButton[3])) {
        gf_AP_HeroChoiceRemoveHero(gv_apHeroChoiceBit[3]);
        gf_AP_HeroChoiceHideExistingHeroes();
        gf_AP_HeroChoiceClose();
        TriggerExecute(gt_MidQ, true, false);
    }
    return true;
}

void gt_APHeroChoiceClicked_Init () {
    gt_APHeroChoiceClicked = TriggerCreate("gt_APHeroChoiceClicked_Func");
    TriggerAddEventDialogControl(gt_APHeroChoiceClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

