<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="Frame" name="TugOfWarFrameTemplate">
        <Width val="760"/>
        <Height val="120"/>
        <Frame type="Image" name="LeftIconImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="9"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="9"/>
            <Width val="79"/>
            <Height val="79"/>
        </Frame>

        <Frame type="Image" name="RightIconImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="9"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-9"/>
            <Width val="79"/>
            <Height val="79"/>
        </Frame>

        <Frame type="Image" name="LeftBarImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="35"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="90"/>
            <Width val="582"/>
            <Height val="44"/>
            <Texture val="@UI/HotS_TugOfWarUnitBarFill"/>
            <TextureType val="NineSlice"/>
            <LayerColor val="142,2,250"/>
        </Frame>

        <Frame type="Image" name="RightBarImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="35"/>
            <Anchor side="Left" relative="$parent/LeftBarImage" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-90"/>
            <Height val="44"/>
            <Texture val="@UI/HotS_TugOfWarUnitBarFill"/>
            <TextureType val="NineSlice"/>
            <LayerColor val="19,222,0"/>
        </Frame>

        <Frame type="Image" name="BorderImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Texture val="@UI/HotS_TugOfWarUnitFrameBorder"/>
        </Frame>

        <Frame type="Image" name="MiddleImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/LeftBarImage" pos="Max" offset="-95"/>
            <Texture val="@UI/HotS_TugOfWarUnitFrameMiddle"/>
            <Alpha val="255"/>
        </Frame>

        <Frame type="Image" name="MiddlePulseImage">
            <Anchor side="Top" relative="$parent/MiddleImage" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/MiddleImage" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/MiddleImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/MiddleImage" pos="Mid" offset="0"/>
            <Width val="170"/>
            <Height val="96"/>
            <Texture val="@UI/HotS_TugOfWarUnitFrameMiddle"/>
            <BlendMode val="Add"/>
            <Alpha val="50"/>

            <Animation name="Pulse">
                <Event event="PulsePlay" action="Reset"/>
                <Event event="PulsePlay" action="Play"/>

                <Controller type="Dimension" dimension="Width" relative="False" percentage="False" end="Loop">
                    <Key type="Curve" time="0.0" value="154" in="Slow" out="Slow"/>
                    <Key type="Curve" time="1.95" value="154" in="Slow" out="Slow"/>
                    <Key type="Curve" time="2.70" value="184" in="Slow" out="Slow"/>
                    <Key type="Curve" time="3.75" value="154" in="Slow" out="Slow"/>
                </Controller>

                <Controller type="Dimension" dimension="Height" relative="False" percentage="False" end="Loop">
                    <Key type="Curve" time="0.0" value="86" in="Slow" out="Slow"/>
                    <Key type="Curve" time="1.95" value="86" in="Slow" out="Slow"/>
                    <Key type="Curve" time="2.70" value="104" in="Slow" out="Slow"/>
                    <Key type="Curve" time="3.75" value="86" in="Slow" out="Slow"/>
                </Controller>

                <Controller type="Fade" end="Loop">
                    <Key type="Curve" time="0.0" value="8" in="Slow" out="Slow"/>
                    <Key type="Curve" time="1.95" value="8" in="Slow" out="Slow"/>
                    <Key type="Curve" time="2.70" value="88" in="Slow" out="Slow"/>
                    <Key type="Curve" time="3.75" value="8" in="Slow" out="Slow"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="FlashFrame" name="TugOfWarEffects" template="ap_phantoms_gameunitframe/TugOfWarEffectsTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-23"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="-6"/>
            <File val="UI/Flash/GameUI/UI_HotS_TugOfWar.swf"/>
        </Frame>

        <Frame type="Label" name="LeftNameLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="104"/>
            <Style val="AP_TugOfWarUnitFrameName"/>
            <Text val="LeftNameLabel"/>
        </Frame>

        <Frame type="Label" name="RightNameLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-101"/>
            <Style val="AP_TugOfWarUnitFrameNameRight"/>
            <Text val="RightNameLabel"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="TugOfWarFrameTemplateSmall">
        <Width val="529"/>
